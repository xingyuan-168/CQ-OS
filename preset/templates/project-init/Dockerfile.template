# Generic Dockerfile template for a Node/LTS base.
# Adapt the FROM image, port, and start command to the project stack.
FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package*.json ./
RUN npm install

# Copy source.
COPY . .

# Default listen port; adjust to the service.
EXPOSE 3000

CMD ["npm", "start"]
